NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OCR_SERVICE_URL=http://localhost:8000  # private PaddleOCR service URL, server-side only
OCR_SERVICE_TOKEN=                  # same secret as the OCR service
SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose in NEXT_PUBLIC_* variables
DOC_LINK_SECRET=            # REQUIRED, 32+ random chars: signs customer document links (openssl rand -hex 32)
NEXT_PUBLIC_ERP_URL=http://localhost:3001   # public base URL used in WhatsApp document links
DOC_RENDER_BASE=            # optional: internal URL the PDF renderer loads (defaults to request origin)
CHROME_EXECUTABLE_PATH=     # optional: local Chrome for PDF generation (serverless uses @sparticuz/chromium)
DOC_PDF_ENGINE=builtin      # builtin (default, no browser needed) | chromium (exact print-design PDF; needs Chromium, falls back to builtin)

INTEGRATION_HEALTH_TOKEN=           # shared random token for ERP-to-storefront status check
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Razorpay subscription checkout — server-side pair is secret, the *_KEY_ID is public.
# Same values as the repo-root .env (Next only loads env from apps/erp).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Signature secret for the razorpay-webhook edge function (Razorpay dashboard -> Webhooks).
# Set with: supabase secrets set RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_WEBHOOK_SECRET=
