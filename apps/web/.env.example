NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_TOKEN=                  # same secret as the OCR service
NEXT_PUBLIC_WEB_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_your_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret   # required: webhook rejects unsigned events
SITE_PREVIEW_KEY=                              # optional: enables ?preview=1&k=
ERP_ORIGIN=http://localhost:3001               # production ERP origin(s), comma separated
DEFAULT_ORG_ID=   # development/single-tenant fallback only; production multi-tenant hosts must be mapped
ALLOW_DEFAULT_ORG_FALLBACK=false # set true only for an intentionally single-tenant production deployment

INTEGRATION_HEALTH_TOKEN=           # shared random token for ERP-to-storefront status check