# ── Required (both apps) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the browser
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001  # storefront fallback when the host is not in org_domains
NEXT_PUBLIC_APP_URL=                  # public URL of the ERP, e.g. https://erp.example.com (used for the Google OAuth redirect)
NEXT_PUBLIC_WEB_URL=                  # public URL of the storefront

# ── Payments (Razorpay) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ── Google Drive backup (see SETUP.md → Backup) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=                          # long random string; Vercel Cron sends it as a Bearer token to /api/cron/backup

# ── Optional ─────────────────────────────────────────────────────────
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=
INTEGRATION_HEALTH_TOKEN=
DOC_LINK_SECRET=
SITE_PREVIEW_KEY=
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
